    "command": "python3 - <<'EOF'\nimport json\n\nwith open(\"/tmp/jev-integration/extension-code/src/templates/template.json\") as f:\n    data = json.load(f)\n\nfields = data.get(\"fields\", [])\n\n# Check field count\nprint(f\"Field count: {len(fields)}\")\n\n# Check sequences are 0-indexed sequential\nsequences = [f.get(\"sequence\") for f in fields]\nprint(f\"Sequences: {sequences}\")\n\n# Check extensionStatus count\next_status = [f[\"name\"] for f in fields if f.get(\"extensionStatus\") is True]\nprint(f\"extensionStatus=true fields: {ext_status}\")\n\n# Check output only fields\noutput_only = [f[\"name\"] for f in fields if f.get(\"fieldRestriction\") == \"Output Only\"]\nprint(f\"Output Only fields: {output_only}\")\n\n# Check fieldMappings are unique\nmappings = [f[\"fieldMapping\"] for f in fields]\nfrom collections import Counter\ndup_mappings = [m for m, c in Counter(mappings).items() if c > 1]\nprint(f\"Duplicate fieldMappings: {dup_mappings}\")\n\n# Check names are unique\nnames = [f[\"name\"] for f in fields]\ndup_names = [n for n, c in Counter(names).items() if c > 1]\nprint(f\"Duplicate names: {dup_names}\")\n\n# Check all required properties on every field\nrequired_props = [\n    \"allowVariable\", \"arrayFieldValue\", \"arrayNameTitle\", \"arrayValueTitle\",\n    \"booleanNoValue\", \"booleanValueType\", \"booleanYesValue\",\n    \"choiceAllowEmpty\", \"choiceAllowMultiple\", \"choiceDynamic\", \"choiceFields\", \"choiceSortOption\", \"choices\",\n    \"defaultListView\", \"extensionStatus\",\n    \"fieldLength\", \"fieldMapping\", \"fieldRegex\", \"fieldRestriction\", \"fieldType\", \"fieldValue\",\n    \"formColumnSpan\", \"formEndRow\", \"formStartRow\",\n    \"hint\", \"intFieldMax\", \"intFieldMin\",\n    \"label\", \"name\", \"noSpaceIfHidden\",\n    \"preserveOutputOnRerun\", \"preserveValueIfHidden\",\n    \"requireIfField\", \"requireIfFieldValue\", \"requireIfVisible\", \"required\",\n    \"sequence\", \"showIfField\", \"showIfFieldValue\", \"sysId\",\n    \"textType\"\n]\n\nfor f in fields:\n    missing = [p for p in required_props if p not in f]\n    if missing:\n        print(f\"Field '{f['name']}' missing properties: {missing}\")\n\nprint(\"All fields have required properties.\" if all(\n    not [p for p in required_props if p not in f] for f in fields\n) else \"\")\n\n# Print field summary\nprint(\"\\nField layout summary:\")\nfor f in fields:\n    print(f\"  seq={f['sequence']:2d}  {f['name']:25s}  {f['fieldMapping']:20s}  span={f['formColumnSpan']}  start={f['formStartRow']}  end={f['formEndRow']}  restriction={f.get('fieldRestriction','')}\")\n\nEOF\n",
